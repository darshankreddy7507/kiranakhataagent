# Kirana Khata Agent — Environment Configuration
# Copy to .env and fill credentials for production integrations.
# In demo mode (APP_MODE=demo), seeded mock adapters run without API keys.

APP_MODE=demo
SHOP_NAME="Kirana Khata Agent"
SHOP_NAME_KN="ಕಿರಾಣಾ ಖಾತಾ ಏಜೆಂಟ್"
OWNER_NAME="Manjunath Gowda"

# Database (SQLite for demo; switch to PostgreSQL / Supabase connection URI in production)
DATABASE_URL=sqlite:///./kirana_khata.db
# DATABASE_URL=postgresql+psycopg2://postgres:password@db.supabase.co:5432/postgres

# Frontend URL / CORS
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Google Sheets Inventory & Khata Sync
GOOGLE_SHEETS_CREDENTIALS_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Razorpay UPI Payment Links & Webhooks
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Kannada Speech-to-Text Adapter
KANNADA_STT_API_KEY=
KANNADA_STT_ENDPOINT=

# Supplier Bill-Image OCR Adapter
BILL_OCR_API_KEY=
BILL_OCR_ENDPOINT=
